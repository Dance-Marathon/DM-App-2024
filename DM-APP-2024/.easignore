# Controls what EAS Build uploads (separate from .gitignore/git history).
# api/service.js and api/apiKeys.js are intentionally left OUT of this list
# (unlike .gitignore) so EAS Build can read them straight off this machine's
# disk without depending on .gitignore's exclusion behavior, which proved
# unreliable for the build archive step specifically.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
